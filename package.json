{
  "name": "chess-electron",
  "version": "2.0.0",
  "description": "Chess.com desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:deb": "electron-builder --linux deb",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:rpm": "electron-builder --linux rpm",
    "lint": "eslint ."
  },
  "build": {
    "appId": "com.tkmxqrd.chess-electron",
    "productName": "Chess.com Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "favicon.ico"
    ],
    "linux": {
      "target": ["deb", "rpm", "dir"],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Game"
    },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "artifactName": "${productName}-${version}.${ext}",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "deb": {
      "depends": ["electron"]
    },
    "rpm": {
      "depends": ["electron"]
    }
  },
  "author": {
    "name": "Jan Fidra",
    "email": "tkmxqrd@gmail.com"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "eslint": "^9.22.0",
    "globals": "^16.0.0"
  }
}
